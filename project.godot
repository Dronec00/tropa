; Engine configuration file.
; Настройки проекта «Тропа».

config_version=5

[application]

config/name="Тропа"
config/description="Мрачный соулслайк в русском лесу."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/directional_shadow_mode=1
lights_and_shadows/directional_shadow/max_distance=55.0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.05, 1)
